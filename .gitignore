# ============================================================
# Clinivet Arias — .gitignore
# ============================================================

# --- Secretos y configuración local ---
# application.yml contiene credenciales reales: BD, JWT, etc.
# NUNCA subir al repo. Usar application-example.yml como plantilla.
src/main/resources/application.yml
src/main/resources/application-*.yml
!src/main/resources/application-example.yml

# --- Compilados y empaquetados de Maven ---
target/
*.class
*.jar
*.war
*.ear

# --- IntelliJ IDEA ---
.idea/
*.iml
*.iws
*.ipr
out/

# --- Eclipse / STS ---
.project
.classpath
.settings/
bin/

# --- VS Code ---
.vscode/

# --- macOS ---
.DS_Store
**/.DS_Store

# --- Windows ---
Thumbs.db
desktop.ini

# --- Logs generados ---
*.log
logs/

# --- Maven Wrapper (generado localmente) ---
!.mvn/
!mvnw
!mvnw.cmd

# --- Variables de entorno ---
.env
*.env

