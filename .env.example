# ============================================================
# Clinivet Arias — Plantilla de Variables de Entorno (.env.example)
# Copiar este archivo a .env y completar con las credenciales
# ============================================================

# ── Base de Datos (Supabase PostgreSQL) ─────────────────────
DB_HOST=aws-0-ca-central-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<REF_PROYECTO>
DB_PASSWORD=<TU_PASSWORD>

# URLs de conexión
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://<DB_HOST>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=<DB_USER>
SPRING_DATASOURCE_PASSWORD=<TU_PASSWORD>

# ── Autenticación JWT (Spring Security) ─────────────────────
JWT_SECRET=<CLAVE_HMAC_SHA256_MINIMO_256_BITS>
JWT_EXPIRATION_MS=86400000

# ── Servidor ─────────────────────────────────────────────────
PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
